profiles {
    spot_retry {
        process {
            // Retry on failures up to 3 times
            errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
            maxRetries = 3
            maxErrors = '-1'
            
            // Log retry attempts for visibility
            beforeScript = { 
                task.attempt > 1 ? 
                "echo '[Retry attempt ${task.attempt} of 4] Previous attempt failed, retrying immediately...'" : 
                '' 
            }
            
            // SPADES-specific configuration
            withName: SPADES {
                errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
                maxRetries = 3
            }
        }
        
        aws {
            batch {
                // AWS Batch configuration for better retry handling
                retryMode = 'built-in'
                maxParallelTransfers = 8
                maxTransferAttempts = 3
            }
        }
    }
}